# ==============================================================================
# Multimodal Character AI - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Custom Asset Repository Locations (Characters, Voices, Scenarios)
# ------------------------------------------------------------------------------
# Option A: Specify a single root directory for your external assets repository.
# Subdirectories 'characters', 'voices' (or 'voice_samples'), and 'scenarios' will be auto-resolved.
# ASSETS_DIR=/workspace/my-cai-assets

# Option B: Or specify individual directories for independent deployment & versioning:
# CHARACTERS_DIR=/workspace/my-cai-assets/characters
# VOICES_DIR=/workspace/my-cai-assets/voices
# SCENARIOS_DIR=/workspace/my-cai-assets/scenarios

# ------------------------------------------------------------------------------
# 2. Hugging Face Authentication & Model Weights
# ------------------------------------------------------------------------------
# HF_TOKEN=hf_your_token_here
# HF_HOME=/workspace/huggingface-cache

# ------------------------------------------------------------------------------
# 3. Model & Service Engine Configuration
# ------------------------------------------------------------------------------
# VLLM_MODEL_NAME=mistralai/Pixtral-12B-2409
# VLLM_BASE_URL=http://127.0.0.1:9001
# TTS_ENGINE=omnivoice   # Options: 'omnivoice', 'f5_tts', 'edge_tts'
# STT_SERVICE_URL=http://127.0.0.1:8002/transcribe
# TTS_SERVICE_URL=http://127.0.0.1:8003/synthesize

# ------------------------------------------------------------------------------
# 4. Default LLM Generation Hyperparameters
# ------------------------------------------------------------------------------
# DEFAULT_TEMPERATURE=0.6
# DEFAULT_TOP_P=0.85
# DEFAULT_MIN_P=0.0
# DEFAULT_REPETITION_PENALTY=1.05
# DEFAULT_MAX_TOKENS=1024
